# Caddy med webdelens sider indbygget.
# 1) Next.js bygges til statiske filer (out/) – der kører intet Node-program på serveren.
# 2) Caddy udleverer filerne og sender /api, /login, /logout og /auth videre til Python-delen.
FROM node:22-alpine AS sider
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM caddy:2
COPY --from=sider /web/out /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
