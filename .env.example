# Kopiér denne fil til .env og udfyld værdierne lokalt.
# .env må ALDRIG committes. Denne fil må ALDRIG indeholde rigtige værdier.

# --- Applikation ---
# development lokalt, production på serveren (bruges også som environment i Sentry)
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (bruges af docker-compose.yml og applikationen) ---
POSTGRES_USER=afstemning
POSTGRES_PASSWORD=skift-mig
POSTGRES_DB=afstemningsmotor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://afstemning:skift-mig@localhost:5432/afstemningsmotor

# --- Hovednøgle til kryptering af kunde-tokens i databasen ---
# Lav din egen med:  python -m app.sikkerhed.ny_noegle --gem
# Mistes nøglen, kan de gemte tokens ikke læses igen – gem en kopi sikkert.
CREDENTIALS_KEY=

# --- e-conomic (fælles app-nøgle; kundens egen token gemmes krypteret i databasen) ---
# X-AppSecretToken fra jeres app i e-conomics udviklerportal (fælles for alle kunder).
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_API_BASE_URL=https://restapi.e-conomic.com

# --- Dinero (fælles app-oplysninger; kundens egen token gemmes krypteret i databasen) ---
DINERO_CLIENT_ID=
DINERO_CLIENT_SECRET=
DINERO_API_BASE_URL=https://api.dinero.dk

# --- Sikkerhed: bogføring er slået fra som standard ---
# Skal stå til false, indtil et dry-run er gennemgået og godkendt.
ALLOW_BOOKING=false

# --- Fejlrapporter (Sentry). Tom = slået fra. Se DEPLOY.md, trin 7 ---
SENTRY_DSN=

# --- Login med Microsoft (samme konto som Outlook). Tomme = login slået fra. Se DEPLOY.md, trin 8 ---
# Id'erne fra app-registreringen i Microsoft Entra (ikke hemmelige).
MS_TENANT_ID=
MS_CLIENT_ID=
# Hemmelig – kun her i .env, aldrig i chat, mail eller git.
MS_CLIENT_SECRET=
# Nøgle til login-cookien. Lav en med: openssl rand -hex 32
SESSION_SECRET=
# Adressen brugerne åbner. Lokalt: http://localhost:8000
PUBLIC_URL=https://hub.dinbogholder.dk

# =====================================================================
# --- Server (kun på Hetzner – se DEPLOY.md) ---
# På serveren skal DATABASE_URL pege på db-containeren (værtsnavn "db"):
#   DATABASE_URL=postgresql+psycopg://afstemning:<POSTGRES_PASSWORD>@db:5432/afstemningsmotor
# og APP_ENV=production.
DOMAIN=hub.dinbogholder.dk
# Brugernavn og adgangskode foran alt andet end /health, indtil der er rigtigt login.
BASIC_AUTH_USER=
# KUN hashen af adgangskoden – aldrig selve koden. Lav den med:
#   docker run --rm -it caddy:2 caddy hash-password
# og sæt den i ENKELTE anførselstegn, fx BASIC_AUTH_HASH='$2a$14$...'
BASIC_AUTH_HASH=

# --- Backup (scripts/backup.sh og scripts/gendan_test.sh) ---
BACKUP_MAPPE=/var/backups/afstemning
# Fil med backup-nøglen (gpg). Gem ALTID en kopi af nøglen i en adgangskodemanager.
BACKUP_NOEGLEFIL=/etc/afstemning/backup-noegle
# Kopi uden for serveren, fx en Hetzner Storage Box: uXXXXX@uXXXXX.your-storagebox.de:afstemning/
BACKUP_FJERN=
