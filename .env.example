# Kopiér denne fil til .env og udfyld værdierne lokalt.
# .env må ALDRIG committes. Denne fil må ALDRIG indeholde rigtige værdier.

# --- Applikation ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (bruges af docker-compose.yml og applikationen) ---
POSTGRES_USER=afstemning
POSTGRES_PASSWORD=skift-mig
POSTGRES_DB=afstemningsmotor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://afstemning:skift-mig@localhost:5432/afstemningsmotor

# --- Kryptering af kunde-tokens i databasen ---
# Nøgle til at kryptere e-conomic- og Dinero-tokens pr. kunde.
TOKEN_ENCRYPTION_KEY=

# --- e-conomic (fælles app-nøgle; kundens egen token gemmes krypteret i databasen) ---
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_API_BASE_URL=https://restapi.e-conomic.com

# --- Dinero (fælles app-oplysninger; kundens egen token gemmes krypteret i databasen) ---
DINERO_CLIENT_ID=
DINERO_CLIENT_SECRET=
DINERO_API_BASE_URL=https://api.dinero.dk

# --- Sikkerhed: bogføring er slået fra som standard ---
# Skal stå til false, indtil et dry-run er gennemgået og godkendt.
ALLOW_BOOKING=false
